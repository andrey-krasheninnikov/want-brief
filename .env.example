HTTP_ADDR=:8080
CORS_ORIGIN=http://127.0.0.1:5173
# Scratch. `make api-dev` + `make web-dev`
DEV_DATABASE_URL=postgres://wantbrief:wantbrief@127.0.0.1:5432/wantbrief_dev?sslmode=disable
DEV_HTTP_ADDR=:8081
DEV_CORS_ORIGIN=http://127.0.0.1:5174
# Test mailbox for local signup, recovery and invitations
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=brief@example.invalid
SMTP_TLS=none
# Production uses tls or starttls. Set both credentials when the relay requires them.
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Set only when this reverse proxy overwrites X-Real-IP.
# TRUSTED_PROXY_IP=127.0.0.1
# Browser origin for emailed links and session cookies. Defaults to CORS_ORIGIN.
# PUBLIC_APP_URL=https://brief.example.org
# 32-byte key, hex-encoded
TOKEN_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
